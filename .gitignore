@"
# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Coverage / test artifacts
.coverage
htmlcov/
coverage.xml

# Docker / local runtime
docker-compose.override.yml

# Local databases / data
*.db
*.sqlite
*.sqlite3

# Temporary
*.tmp
*.temp
*.log
"@ | Set-Content -Encoding UTF8 .gitignore